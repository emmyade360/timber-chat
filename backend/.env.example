# --- Database -------------------------------------------------------------
# Supabase is used for Postgres and object storage only. It is NOT used for
# authentication: Timber accounts are non-custodial, and the server never holds
# a credential capable of signing in as a user.
# Use the Supabase pooler's SSL connection string for app traffic.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Keep this at or below the connection limit assigned by your pooler plan.
DATABASE_MAX_CONNECTIONS=5

# --- Object storage (encrypted attachments) -------------------------------
# Attachments arrive already sealed by the sender's device. The bucket only ever
# holds opaque blobs; the key to open one travels inside the encrypted message.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>

# --- Browser origin policy ------------------------------------------------
# Comma-separated frontend origins allowed to call the API or open a WebSocket.
# Production must use explicit HTTPS origins; '*' is deliberately rejected.
ALLOWED_ORIGINS=http://localhost:5173
# Render production deployment: https://timbachat.vercel.app

# --- WebRTC calling --------------------------------------------------------
# Calls use the authenticated WebSocket only for short-lived signalling. Audio
# and video travel directly between browsers (or through TURN) over DTLS/SRTP.
# Configure your own STUN/TURN service in production; no third-party relay is
# silently selected by Timber. Include UDP and TLS/TCP TURN URLs for reliability.
# WEBRTC_STUN_URLS=stun:stun.example.com:3478
# WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# Preferred for coturn's REST API: never expose a long-lived credential to the
# browser. Configure the same static-auth-secret in coturn.
# WEBRTC_TURN_SHARED_SECRET=<coturn-static-auth-secret>
# Managed TURN providers that do not support REST credentials can use these
# instead (they are returned only to authenticated callers):
# WEBRTC_TURN_USERNAME=<provider-username>
# WEBRTC_TURN_CREDENTIAL=<provider-credential>

# Optional; defaults to 8080
PORT=8080
