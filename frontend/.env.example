VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080

# Public half of the relay's VAPID key pair, URL-safe and unpadded. Public by
# design: it only lets a browser check which server signed a push, and is
# useless without the private half.
#
# It must MATCH the WEB_PUSH_VAPID_PRIVATE_KEY on the relay you are pointing at.
# Copying another deployment's key here produces subscriptions that deployment
# cannot sign for, and every push fails per delivery rather than at startup.
# Generate a pair with the script in ../DEPLOYMENT.md.
#
# Leave this unset and background alerts simply stay unavailable; nothing else
# breaks. The live deployment's value is in .env.production.
VITE_WEB_PUSH_PUBLIC_KEY=

# Production: use HTTPS/WSS endpoints. The client refuses HTTP or WS when the
# page itself was delivered over HTTPS.
# The repository's default production endpoints live in .env.production and
# match the Render service declared in ../render.yaml. Override both values in
# Vercel only when using a different public API domain, and update the exact
# connect-src allowlist in vercel.json at the same time.
