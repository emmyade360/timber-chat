# Public production endpoints for the live Render service declared in ../render.yaml.
# These are client-side URLs, not credentials. Vercel project environment
# variables can override them if the API is later moved to a custom domain.
# If they change, update frontend/vercel.json's CSP connect-src at the same time;
# keeping it exact prevents an injected script from sending data to arbitrary hosts.
VITE_API_URL=https://timber-chat.onrender.com
VITE_WS_URL=wss://timber-chat.onrender.com
